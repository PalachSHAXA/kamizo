{
  "name": "frontend",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:bundle-budget": "node scripts/verify-bundle-budget.mjs",
    "build:budget": "npm run build && npm run verify:bundle-budget",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:bundle-budget && npm run test:workflow-safety",
    "test:unit": "vitest run",
    "test:bundle-budget": "node --test scripts/verify-bundle-budget.test.mjs",
    "test:workflow-safety": "node --test scripts/workflow-safety.test.mjs && bash ../../scripts/tests/backend_production_preflight_test.sh",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:isolated",
    "test:e2e:isolated": "node e2e/isolated/run-isolated.mjs",
    "test:e2e:demo": "playwright test --config playwright.demo-isolated.config.ts",
    "test:e2e:harness": "node --test e2e/isolated/*.test.mjs",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.562.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.6.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
